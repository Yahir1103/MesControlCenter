# MES Control Center - WebSocket server config
# Copia este archivo a .env y rellena los valores reales.

# Puerto donde escucha el servidor WS/HTTP
PORT=8092

# Credenciales MySQL (UNICO lugar donde viven; nunca en los agentes)
DB_HOST=localhost
DB_PORT=3306
DB_USER=mescc
DB_PASSWORD=changeme
DB_DATABASE=mes_production

# Token que usan los dashboards admin para autenticarse por WS.
# Genera uno largo y aleatorio (p.ej. openssl rand -hex 32).
ADMIN_TOKEN=changeme-admin-token

# Backups MySQL/MariaDB. Estos valores solo inicializan la configuración; luego
# la hora y retención pueden cambiarse desde la app.
BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_TIME=22:00
BACKUP_TIMEZONE=America/Mexico_City
BACKUP_RETENTION_DAYS=7
MYSQLDUMP_PATH=mysqldump

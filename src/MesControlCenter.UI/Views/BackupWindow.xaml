<Window x:Class="MesControlCenter.UI.Views.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Database Backups" Height="780" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,12" Background="#161b22"
                BorderBrush="#21262d" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border CornerRadius="8" Width="32" Height="32" Margin="0,0,12,0"
                            Background="#238636">
                        <Path Data="{StaticResource DatabaseGeometry}" Stroke="White" StrokeThickness="1.3"
                              Width="16" Height="18" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Database Backups" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#e6edf3"/>
                        <TextBlock Text="Local MySQL backup scheduler" FontSize="10"
                                   Foreground="#484f58" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border CornerRadius="10" Padding="10,4" Background="#0e1117" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding BackupStateColor}" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding BackupStateText}" Foreground="{Binding BackupStateColor}"
                                       FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Refresh" Style="{StaticResource AccentButton}" Padding="14,5"
                            FontSize="11" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="12,7"
                Background="#0e1117" BorderBrush="#21262d" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#7d8590" FontSize="12"/>
        </Border>

        <Grid Margin="14">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#7d8590" FontSize="14"/>
            </StackPanel>

            <Grid Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="390"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="8" Padding="16"
                            Background="{StaticResource PanelBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Database Connection" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,12"/>

                                <TextBlock Text="Host" FontSize="11" FontWeight="Medium"
                                           Foreground="#7d8590" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DbHost, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="localhost" Margin="0,0,0,10"/>

                                <TextBlock Text="Port" FontSize="11" FontWeight="Medium"
                                           Foreground="#7d8590" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DbPortText, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="3306" Margin="0,0,0,10"/>

                                <TextBlock Text="Database" FontSize="11" FontWeight="Medium"
                                           Foreground="#7d8590" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DbDatabase, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="mes_production" Margin="0,0,0,10"/>

                                <TextBlock Text="User" FontSize="11" FontWeight="Medium"
                                           Foreground="#7d8590" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DbUser, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="mes_admin" Margin="0,0,0,10"/>

                                <TextBlock Text="Password" FontSize="11" FontWeight="Medium"
                                           Foreground="#7d8590" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="DbPasswordBox"
                                             PasswordChanged="DbPasswordBox_PasswordChanged"
                                             Margin="0,0,0,10"/>

                                <TextBlock Text="mysqldump path" FontSize="11" FontWeight="Medium"
                                           Foreground="#7d8590" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding MysqldumpPath, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="mysqldump" FontFamily="Cascadia Code, Consolas"/>
                                    <Button Grid.Column="2" Content="Browse" Style="{StaticResource DarkButton}"
                                            Command="{Binding BrowseMysqldumpPathCommand}" Padding="12,6"/>
                                </Grid>

                                <TextBlock Text="Schedule" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,12"/>

                                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}"
                                          Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,12"/>

                                <TextBlock Text="Daily time (HH:mm)" FontSize="11" FontWeight="Medium"
                                           Foreground="#7d8590" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding BackupTime, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="22:00" Margin="0,0,0,12"/>

                                <TextBlock Text="Retention days" FontSize="11" FontWeight="Medium"
                                           Foreground="#7d8590" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding RetentionDaysText, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="7" Margin="0,0,0,12"/>

                                <TextBlock Text="Timezone" FontSize="11" FontWeight="Medium"
                                           Foreground="#7d8590" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Timezone}" Foreground="#e6edf3"
                                           TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>

                                <TextBlock Text="Backup folder" FontSize="11" FontWeight="Medium"
                                           Foreground="#7d8590" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding BackupDir, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="C:\MES_Backups" FontFamily="Cascadia Code, Consolas"/>
                                    <Button Grid.Column="2" Content="Browse" Style="{StaticResource DarkButton}"
                                            Command="{Binding BrowseBackupDirCommand}" Padding="12,6"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Save" Style="{StaticResource SuccessButton}"
                                            Command="{Binding SaveConfigCommand}" Padding="16,7" Margin="0,0,8,0"/>
                                    <Button Content="Run Now" Style="{StaticResource AccentButton}"
                                            Command="{Binding RunNowCommand}" Padding="16,7"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="2" CornerRadius="8" Padding="16"
                            Background="{StaticResource PanelBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Current Status" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,12"/>

                            <Border Visibility="{Binding IsBackupRunning, Converter={StaticResource BoolToVisibility}}"
                                    CornerRadius="8" Padding="12" Background="#0e1117"
                                    BorderBrush="#30363d" BorderThickness="1" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Backup running"
                                                   Foreground="#58a6ff" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{Binding RunningBackupText}"
                                                   Foreground="#8b949e" FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <Grid Height="6" ClipToBounds="True" Margin="0,10,0,0">
                                        <Border CornerRadius="3" Background="#21262d"/>
                                        <Border Width="110" CornerRadius="3" HorizontalAlignment="Left"
                                                Background="#58a6ff">
                                            <Border.RenderTransform>
                                                <TranslateTransform X="-110"/>
                                            </Border.RenderTransform>
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                             From="-110" To="340"
                                                                             Duration="0:0:1.35"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Next backup" FontSize="11" FontWeight="Medium" Foreground="#7d8590"/>
                            <TextBlock Text="{Binding NextRunText}" Foreground="#e6edf3" FontSize="13"
                                       Margin="0,2,0,12"/>

                            <TextBlock Text="Last result" FontSize="11" FontWeight="Medium" Foreground="#7d8590"/>
                            <TextBlock Text="{Binding LastRunText}" Foreground="#e6edf3" FontSize="13"
                                       TextWrapping="Wrap" Margin="0,2,0,12"/>

                            <TextBlock Text="Duration" FontSize="11" FontWeight="Medium" Foreground="#7d8590"/>
                            <TextBlock Text="{Binding LastDurationText}" Foreground="#e6edf3" FontSize="13"
                                       Margin="0,2,0,12"/>

                            <TextBlock Text="Size" FontSize="11" FontWeight="Medium" Foreground="#7d8590"/>
                            <TextBlock Text="{Binding LastSizeText}" Foreground="#e6edf3" FontSize="13"
                                       Margin="0,2,0,12"/>

                            <TextBlock Text="Last file" FontSize="11" FontWeight="Medium" Foreground="#7d8590"/>
                            <TextBlock Text="{Binding LastFilePath}" Foreground="#e6edf3" FontSize="11"
                                       FontFamily="Cascadia Code, Consolas" TextWrapping="Wrap"
                                       Margin="0,2,0,12"/>

                            <TextBlock Text="Last error" FontSize="11" FontWeight="Medium" Foreground="#7d8590"/>
                            <TextBlock Text="{Binding LastError}" Foreground="#f85149" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Column="2" CornerRadius="8"
                        Background="{StaticResource PanelBgBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="14,10" Background="#1c2128"
                                BorderBrush="#21262d" BorderThickness="0,0,0,1">
                            <TextBlock Text="Backup History" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBlueBrush}"/>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Runs}" IsReadOnly="True"
                                  BorderThickness="0" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding RunType}" Width="90"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                                <DataGridTextColumn Header="Started" Binding="{Binding StartedAt}" Width="150"/>
                                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="90"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90"/>
                                <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="260"/>
                                <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

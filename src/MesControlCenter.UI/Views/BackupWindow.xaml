<Window x:Class="MesControlCenter.UI.Views.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Database Backups" Height="720" Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,12" Background="#161b22"
                BorderBrush="#21262d" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border CornerRadius="8" Width="32" Height="32" Margin="0,0,12,0"
                            Background="#238636">
                        <Path Data="{StaticResource DatabaseGeometry}" Stroke="White" StrokeThickness="1.3"
                              Width="16" Height="18" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Database Backups" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#e6edf3"/>
                        <TextBlock Text="Scheduled MySQL backup monitoring" FontSize="10"
                                   Foreground="#484f58" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border CornerRadius="10" Padding="10,4" Background="#0e1117" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding ServerStateColor}" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding ServerStateText}" Foreground="{Binding ServerStateColor}"
                                       FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Refresh" Style="{StaticResource AccentButton}" Padding="14,5"
                            FontSize="11" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="12,7"
                Background="#0e1117" BorderBrush="#21262d" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#7d8590" FontSize="12"/>
        </Border>

        <Grid Margin="14">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#7d8590" FontSize="14"/>
            </StackPanel>

            <Grid Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="8" Padding="16"
                            Background="{StaticResource PanelBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Schedule" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,12"/>

                            <CheckBox Content="Enabled" IsChecked="{Binding Enabled}"
                                      Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,12"/>

                            <TextBlock Text="Daily time (HH:mm)" FontSize="11" FontWeight="Medium"
                                       Foreground="#7d8590" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding BackupTime, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="22:00" Margin="0,0,0,12"/>

                            <TextBlock Text="Retention days" FontSize="11" FontWeight="Medium"
                                       Foreground="#7d8590" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding RetentionDaysText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="7" Margin="0,0,0,12"/>

                            <TextBlock Text="Timezone" FontSize="11" FontWeight="Medium"
                                       Foreground="#7d8590" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Timezone}" Foreground="#e6edf3"
                                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>

                            <TextBlock Text="Backup folder" FontSize="11" FontWeight="Medium"
                                       Foreground="#7d8590" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding BackupDir}" Foreground="#e6edf3"
                                       TextWrapping="Wrap" FontSize="12" FontFamily="Cascadia Code, Consolas"
                                       Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Save" Style="{StaticResource SuccessButton}"
                                        Command="{Binding SaveConfigCommand}" Padding="16,7" Margin="0,0,8,0"/>
                                <Button Content="Run Now" Style="{StaticResource AccentButton}"
                                        Command="{Binding RunNowCommand}" Padding="16,7"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" CornerRadius="8" Padding="16"
                            Background="{StaticResource PanelBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Current Status" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,12"/>

                            <TextBlock Text="Next backup" FontSize="11" FontWeight="Medium" Foreground="#7d8590"/>
                            <TextBlock Text="{Binding NextRunText}" Foreground="#e6edf3" FontSize="13"
                                       Margin="0,2,0,12"/>

                            <TextBlock Text="Last result" FontSize="11" FontWeight="Medium" Foreground="#7d8590"/>
                            <TextBlock Text="{Binding LastRunText}" Foreground="#e6edf3" FontSize="13"
                                       TextWrapping="Wrap" Margin="0,2,0,12"/>

                            <TextBlock Text="Duration" FontSize="11" FontWeight="Medium" Foreground="#7d8590"/>
                            <TextBlock Text="{Binding LastDurationText}" Foreground="#e6edf3" FontSize="13"
                                       Margin="0,2,0,12"/>

                            <TextBlock Text="Size" FontSize="11" FontWeight="Medium" Foreground="#7d8590"/>
                            <TextBlock Text="{Binding LastSizeText}" Foreground="#e6edf3" FontSize="13"
                                       Margin="0,2,0,12"/>

                            <TextBlock Text="Last file" FontSize="11" FontWeight="Medium" Foreground="#7d8590"/>
                            <TextBlock Text="{Binding LastFilePath}" Foreground="#e6edf3" FontSize="11"
                                       FontFamily="Cascadia Code, Consolas" TextWrapping="Wrap"
                                       Margin="0,2,0,12"/>

                            <TextBlock Text="Last error" FontSize="11" FontWeight="Medium" Foreground="#7d8590"/>
                            <TextBlock Text="{Binding LastError}" Foreground="#f85149" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Column="2" CornerRadius="8"
                        Background="{StaticResource PanelBgBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="14,10" Background="#1c2128"
                                BorderBrush="#21262d" BorderThickness="0,0,0,1">
                            <TextBlock Text="Backup History" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBlueBrush}"/>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Runs}" IsReadOnly="True"
                                  BorderThickness="0" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding RunType}" Width="90"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                                <DataGridTextColumn Header="Started" Binding="{Binding StartedAt}" Width="150"/>
                                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="90"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90"/>
                                <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="260"/>
                                <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

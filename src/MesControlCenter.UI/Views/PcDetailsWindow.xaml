<Window x:Class="MesControlCenter.UI.Views.PcDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Details" Height="520" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBgBrush}"
        Foreground="{StaticResource ForegroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PC Info Card -->
        <Border Grid.Row="0" CornerRadius="12" Padding="20,16"
                Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="0" Opacity="0.2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding PcName}" FontSize="22" FontWeight="Bold"
                               Foreground="White"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Key: " Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding PcKey}" FontSize="12" FontFamily="Cascadia Code, Consolas"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Role: " Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding Role}" FontSize="12" FontWeight="Medium"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Last seen: " Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding LastSeen}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <!-- Status badge -->
                <Border Grid.Column="1" CornerRadius="10" Padding="14,6"
                        VerticalAlignment="Top">
                    <Border.Background>
                        <SolidColorBrush Color="#0d1220"/>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"
                                   FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Section Header -->
        <TextBlock Grid.Row="2" Text="Scripts" FontSize="15" FontWeight="SemiBold"
                   Foreground="{StaticResource AccentBlueBrush}"/>

        <!-- Scripts Table -->
        <Border Grid.Row="4" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" ClipToBounds="True" Background="{StaticResource PanelBgBrush}">
            <DataGrid ItemsSource="{Binding Scripts}" IsReadOnly="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Script Name" Binding="{Binding ScriptName}" Width="*"/>
                    <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                    <DataGridTextColumn Header="Last Heartbeat" Binding="{Binding LastHeartbeat}" Width="160"/>
                    <DataGridTextColumn Header="Extra Status" Binding="{Binding ExtraStatus}" Width="220"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>

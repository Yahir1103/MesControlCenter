<Window x:Class="MesControlCenter.UI.Views.InstallerWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure PC Monitor" Height="460" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBgBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        KeyDown="Window_KeyDown">

    <Grid>
        <Border CornerRadius="16" Margin="20"
                Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="3" Opacity="0.35"/>
            </Border.Effect>
            <StackPanel Margin="28,24">
                <!-- Icon + Title -->
                <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,0,14"
                        HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#059669" Offset="0"/>
                            <GradientStop Color="#0891b2" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Path Data="{StaticResource MonitorGeometry}" Stroke="White" StrokeThickness="1.3"
                          Width="22" Height="18" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="PC Monitor Setup" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Configure this workstation for remote monitoring"
                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- PC Name -->
                <TextBlock Text="PC Name" FontSize="11" FontWeight="Medium"
                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding PcName, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Alphanumeric, hyphens and underscores"/>

                <!-- Server URL -->
                <TextBlock Text="Server URL (ws:// o wss://)" FontSize="11" FontWeight="Medium"
                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,12,0,4"/>
                <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                         Tag="ws://host:8092/ws"/>

                <!-- Progress -->
                <ProgressBar Value="{Binding Progress}" Margin="0,18,0,0"/>

                <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                           FontSize="12"/>

                <!-- Error -->
                <TextBlock Text="{Binding ErrorMessage}" Margin="0,8,0,0"
                           Foreground="{StaticResource ErrorRedBrush}" TextWrapping="Wrap"
                           FontSize="12"/>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="Install" Style="{StaticResource SuccessButton}" Width="110" Margin="0,0,8,0"
                            Click="Install_Click" Padding="14,8"/>
                    <Button Content="Cancel" Style="{StaticResource DarkButton}" Width="100"
                            IsCancel="True" Padding="14,8"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

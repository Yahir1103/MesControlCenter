<Window x:Class="MesControlCenter.UI.Views.NpmCommandEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="npm Script" Height="620" Width="680" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#0e1117"
        Foreground="{StaticResource ForegroundBrush}">

    <Window.Resources>
        <Style TargetType="TabControl">
            <Setter Property="Background"      Value="#0e1117"/>
            <Setter Property="BorderBrush"     Value="#21262d"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding"         Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="#7d8590"/>
            <Setter Property="BorderBrush" Value="#21262d"/>
            <Setter Property="Padding"     Value="16,8"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root" Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Background="Transparent">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#58a6ff"/>
                                <Setter Property="Foreground" Value="#e6edf3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#c9d1d9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="npm Script Configuration"
                   FontSize="16" FontWeight="SemiBold" Foreground="#3fb950"/>

        <!-- Tabs -->
        <TabControl Grid.Row="2">

            <!-- ══════════════ GENERAL ══════════════ -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <StackPanel>
                        <!-- Name -->
                        <TextBlock Text="Name" FontSize="11" FontWeight="Medium" Foreground="#7d8590" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding CommandName, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Display name" Margin="0,0,0,12"/>

                        <!-- Project directory -->
                        <TextBlock Text="Project directory (contains package.json)" FontSize="11" FontWeight="Medium" Foreground="#7d8590" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NpmWorkDir, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="C:\projects\my-app" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse" Style="{StaticResource DarkButton}"
                                    Command="{Binding BrowseDirectoryCommand}" Padding="12,6"/>
                        </Grid>

                        <!-- package.json status -->
                        <TextBlock Text="{Binding PackageJsonStatus}" FontSize="11"
                                   Foreground="#3fb950" Margin="0,0,0,12"
                                   Visibility="{Binding PackageJsonStatus, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- npm script -->
                        <TextBlock Text="Script to run" FontSize="11" FontWeight="Medium" Foreground="#7d8590" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding NpmScript, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="start, dev, build ..." Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" Width="140"
                                      ItemsSource="{Binding AvailableScripts}"
                                      SelectedItem="{Binding NpmScript}"
                                      Visibility="{Binding AvailableScripts.Count, Converter={StaticResource BoolToVisibility}}"
                                      Background="#161b22" Foreground="#e6edf3"
                                      BorderBrush="#30363d"/>
                        </Grid>

                        <!-- Command preview -->
                        <Border CornerRadius="6" Background="#0d2818" Padding="10,6" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Will run: " FontSize="11" Foreground="#484f58"/>
                                <TextBlock FontSize="11" Foreground="#3fb950"
                                           FontFamily="Cascadia Code, Consolas, monospace">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="npm run {0}">
                                            <Binding Path="NpmScript"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Text=" in " FontSize="11" Foreground="#484f58"/>
                                <TextBlock Text="{Binding NpmWorkDir}" FontSize="11" Foreground="#7d8590"
                                           TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                            </StackPanel>
                        </Border>

                        <CheckBox Content="Auto-start when application launches" IsChecked="{Binding AutoStart}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════ RELIABILITY ══════════════ -->
            <TabItem Header="Reliability">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="AUTO-RESTART" FontSize="10" FontWeight="Bold" Foreground="#484f58" Margin="0,0,0,10"/>
                        <CheckBox Content="Restart automatically on non-zero exit code"
                                  IsChecked="{Binding AutoRestart}" Margin="0,0,0,10"/>
                        <StackPanel Visibility="{Binding AutoRestart, Converter={StaticResource BoolToVisibility}}"
                                    Margin="16,0,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Delay (seconds)" FontSize="11" FontWeight="Medium" Foreground="#7d8590" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding RestartDelay, UpdateSourceTrigger=PropertyChanged}" Tag="5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Max attempts (0 = unlimited)" FontSize="11" FontWeight="Medium" Foreground="#7d8590" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding MaxAttempts, UpdateSourceTrigger=PropertyChanged}" Tag="3"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Separator Background="#21262d" Margin="0,14,0,14"/>

                        <TextBlock Text="HTTP HEALTH CHECK" FontSize="10" FontWeight="Bold" Foreground="#484f58" Margin="0,0,0,10"/>
                        <CheckBox Content="Enable HTTP health check (restart if URL stops responding)"
                                  IsChecked="{Binding HealthCheckEnabled}" Margin="0,0,0,10"/>
                        <StackPanel Visibility="{Binding HealthCheckEnabled, Converter={StaticResource BoolToVisibility}}"
                                    Margin="16,0,0,0">
                            <TextBlock Text="Health check URL" FontSize="11" FontWeight="Medium" Foreground="#7d8590" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding HealthCheckUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="http://localhost:3000/health" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Check interval (seconds)" FontSize="11" FontWeight="Medium" Foreground="#7d8590" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding HealthInterval, UpdateSourceTrigger=PropertyChanged}" Tag="30"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Failures before restart" FontSize="11" FontWeight="Medium" Foreground="#7d8590" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding HealthFailures, UpdateSourceTrigger=PropertyChanged}" Tag="3"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══════════════ HOOKS ══════════════ -->
            <TabItem Header="Hooks">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
                    <StackPanel>
                        <Border CornerRadius="6" Background="#161b22" Padding="10,7" Margin="0,0,0,16"
                                BorderBrush="#30363d" BorderThickness="1">
                            <TextBlock Foreground="#7d8590" FontSize="11" TextWrapping="Wrap"
                                       Text="Hooks run as shell commands (cmd.exe /c). Pre-start runs before the process launches and blocks until complete. Post-stop runs after the process exits."/>
                        </Border>

                        <TextBlock Text="FREE PORT (before start)" FontSize="10" FontWeight="Bold" Foreground="#484f58" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding FreePort, UpdateSourceTrigger=PropertyChanged}"
                                 Tag='e.g. 3012 — kills whatever holds this port. Empty = disabled'
                                 Width="160" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                        <TextBlock Text="PRE-START COMMAND" FontSize="10" FontWeight="Bold" Foreground="#484f58" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding PreStartCommand, UpdateSourceTrigger=PropertyChanged}"
                                 Tag='e.g. npm install or setup.bat'
                                 Margin="0,0,0,16"/>

                        <TextBlock Text="POST-STOP COMMAND" FontSize="10" FontWeight="Bold" Foreground="#484f58" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding PostStopCommand, UpdateSourceTrigger=PropertyChanged}"
                                 Tag='e.g. cleanup.bat'/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Error message -->
        <TextBlock Grid.Row="3" Margin="0,6,0,0"
                   Text="{Binding ErrorMessage}" Foreground="#d29922"
                   TextWrapping="Wrap" FontSize="11"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Style="{StaticResource AccentButton}" Width="100" Margin="0,0,8,0"
                    Click="Ok_Click" Padding="12,7"/>
            <Button Content="Cancel" Style="{StaticResource DarkButton}" Width="100"
                    IsCancel="True" Padding="12,7"/>
        </StackPanel>
    </Grid>
</Window>

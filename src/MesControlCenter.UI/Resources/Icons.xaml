<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════ Connected Icon (Green gradient circle + white checkmark) ═══════ -->
    <DrawingImage x:Key="ConnectedIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#34d399" Offset="0"/>
                            <GradientStop Color="#22d3ee" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="8,8" RadiusX="7.5" RadiusY="7.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="White" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 4.5,8 L 7,10.5 L 11.5,5.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════ Disconnected Icon (Red gradient circle + white X) ═══════ -->
    <DrawingImage x:Key="DisconnectedIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#f87171" Offset="0"/>
                            <GradientStop Color="#fb923c" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="8,8" RadiusX="7.5" RadiusY="7.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="White" Thickness="2" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="5,5" EndPoint="11,11"/>
                            <LineGeometry StartPoint="11,5" EndPoint="5,11"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════ Error Icon (Amber gradient circle + white exclamation) ═══════ -->
    <DrawingImage x:Key="ErrorIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#fbbf24" Offset="0"/>
                            <GradientStop Color="#f59e0b" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="8,8" RadiusX="7.5" RadiusY="7.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="White" Thickness="2" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="8,4" EndPoint="8,9"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="8,11.5" RadiusX="1" RadiusY="1"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════ Idle Icon (Blue-grey gradient circle + white dot) ═══════ -->
    <DrawingImage x:Key="IdleIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6b7280" Offset="0"/>
                            <GradientStop Color="#4b5563" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="8,8" RadiusX="7.5" RadiusY="7.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="8,8" RadiusX="2.5" RadiusY="2.5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ═══════ Toolbar Icon Geometries ═══════ -->
    <Geometry x:Key="PlusGeometry">M 8,2 L 8,14 M 2,8 L 14,8</Geometry>
    <Geometry x:Key="EditGeometry">M 2,13 L 2,14 L 3,14 L 11,6 L 10,5 Z M 10.5,4.5 L 11.5,3.5 L 12.5,4.5 L 11.5,5.5 Z</Geometry>
    <Geometry x:Key="TrashGeometry">M 4,4 L 4,13 L 12,13 L 12,4 Z M 3,4 L 13,4 M 6,2 L 10,2 M 7,6 L 7,11 M 9,6 L 9,11</Geometry>
    <Geometry x:Key="PlayGeometry">M 4,2 L 14,8 L 4,14 Z</Geometry>
    <Geometry x:Key="StopGeometry">M 3,3 L 13,3 L 13,13 L 3,13 Z</Geometry>
    <Geometry x:Key="PlayAllGeometry">M 2,2 L 10,8 L 2,14 Z M 8,2 L 14,8 L 8,14</Geometry>
    <Geometry x:Key="SaveGeometry">M 3,2 L 3,14 L 13,14 L 13,5 L 10,2 Z M 6,2 L 6,6 L 10,6 M 6,10 L 10,10 M 6,12 L 10,12</Geometry>
    <Geometry x:Key="MonitorGeometry">M 2,3 L 14,3 L 14,11 L 2,11 Z M 6,11 L 6,14 M 10,11 L 10,14 M 4,14 L 12,14</Geometry>
    <Geometry x:Key="DatabaseGeometry">M 3,4 C 3,2.9 5.2,2 8,2 C 10.8,2 13,2.9 13,4 C 13,5.1 10.8,6 8,6 C 5.2,6 3,5.1 3,4 Z M 3,4 L 3,12 C 3,13.1 5.2,14 8,14 C 10.8,14 13,13.1 13,12 L 13,4 M 3,8 C 3,9.1 5.2,10 8,10 C 10.8,10 13,9.1 13,8</Geometry>

</ResourceDictionary>

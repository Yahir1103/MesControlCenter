<Window x:Class="MesControlCenter.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:MesControlCenter.UI.Helpers"
        Title="MES Control Center" Height="820" Width="1360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        Loaded="Window_Loaded">

    <DockPanel>
        <!-- ═══════ TOOLBAR ═══════ -->
        <Border DockPanel.Dock="Top" Padding="10,7" Background="#0e1117"
                BorderBrush="#21262d" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Left: grouped buttons -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <!-- Management Group -->
                    <TextBlock Text="MANAGE" FontSize="10" FontWeight="Bold" Foreground="#484f58"
                               VerticalAlignment="Center" Margin="8,0,8,0"/>
                    <Button Style="{StaticResource ToolIconButton}" ToolTip="Add script (.py / .exe)"
                            Command="{Binding AddScriptCommand}" Padding="10,8">
                        <Path Data="{StaticResource PlusGeometry}" Stroke="#3fb950" StrokeThickness="2.2"
                              Width="16" Height="16" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button Style="{StaticResource ToolIconButton}" ToolTip="Add PowerShell command"
                            Command="{Binding AddPsCommandCommand}" Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource PlusGeometry}" Stroke="#a371f7" StrokeThickness="2.2"
                                  Width="13" Height="13" Stretch="Uniform"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBlock Text="PS" Margin="4,0,0,0" VerticalAlignment="Center"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#a371f7"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolIconButton}" ToolTip="Add npm script"
                            Command="{Binding AddNpmCommandCommand}" Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource PlusGeometry}" Stroke="#3fb950" StrokeThickness="2.2"
                                  Width="13" Height="13" Stretch="Uniform"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBlock Text="npm" Margin="4,0,0,0" VerticalAlignment="Center"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#3fb950"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolIconButton}" ToolTip="Edit selected"
                            Command="{Binding EditScriptCommand}" Padding="10,8">
                        <Path Data="{StaticResource EditGeometry}" Fill="#58a6ff"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource ToolIconButton}" ToolTip="Remove selected"
                            Command="{Binding RemoveScriptCommand}" Padding="10,8">
                        <Path Data="{StaticResource TrashGeometry}" Stroke="#f85149" StrokeThickness="1.3"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>

                    <Rectangle Style="{StaticResource ToolbarSeparator}"/>

                    <!-- Execution Group -->
                    <TextBlock Text="RUN" FontSize="10" FontWeight="Bold" Foreground="#484f58"
                               VerticalAlignment="Center" Margin="6,0,8,0"/>
                    <Button Style="{StaticResource ToolIconButton}" ToolTip="Run selected"
                            Command="{Binding RunScriptCommand}" Padding="10,8">
                        <Path Data="{StaticResource PlayGeometry}" Fill="#3fb950"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource ToolIconButton}" ToolTip="Stop selected"
                            Command="{Binding StopScriptCommand}" Padding="10,8">
                        <Path Data="{StaticResource StopGeometry}" Fill="#f85149"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <Rectangle Style="{StaticResource ToolbarSeparator}"/>

                    <Button Style="{StaticResource ToolIconButton}" ToolTip="Run all scripts"
                            Command="{Binding RunAllCommand}" Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource PlayAllGeometry}" Stroke="#3fb950" StrokeThickness="1.5"
                                  Width="16" Height="14" Stretch="Uniform"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBlock Text="All" Margin="5,0,0,0" VerticalAlignment="Center"
                                       FontSize="13" Foreground="#7d8590"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolIconButton}" ToolTip="Stop all scripts"
                            Command="{Binding StopAllCommand}" Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource StopGeometry}" Fill="#f85149"
                                  Width="13" Height="13" Stretch="Uniform"/>
                            <TextBlock Text="All" Margin="5,0,0,0" VerticalAlignment="Center"
                                       FontSize="13" Foreground="#7d8590"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: Backups -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource SuccessButton}" ToolTip="Database Backups"
                            Command="{Binding OpenBackupsCommand}" Padding="14,7">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource DatabaseGeometry}" Stroke="White" StrokeThickness="1.3"
                                  Width="15" Height="16" Stretch="Uniform"/>
                            <TextBlock Text="Backups" Margin="7,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Center: live system metrics (CPU / RAM / temp), visible everywhere -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Background="#0d1117" BorderBrush="#21262d" BorderThickness="1"
                            CornerRadius="6" Padding="10,4" Margin="6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CPU" FontSize="10" FontWeight="Bold" Foreground="#484f58"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding SysCpuText}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#58a6ff" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#0d1117" BorderBrush="#21262d" BorderThickness="1"
                            CornerRadius="6" Padding="10,4" Margin="6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="RAM" FontSize="10" FontWeight="Bold" Foreground="#484f58"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding SysRamText}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#3fb950" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SysRamDetail}" FontSize="10" Foreground="#7d8590"
                                       VerticalAlignment="Center" Margin="6,1,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#0d1117" BorderBrush="#21262d" BorderThickness="1"
                            CornerRadius="6" Padding="10,4" Margin="6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TEMP" FontSize="10" FontWeight="Bold" Foreground="#484f58"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding SysTempText}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#d29922" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#0d1117" BorderBrush="#21262d" BorderThickness="1"
                            CornerRadius="6" Padding="10,4" Margin="6,0"
                            ToolTip="{Binding DbStatusToolTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource DatabaseGeometry}" Stroke="{Binding DbStatusColor}"
                                  StrokeThickness="1.4" Width="14" Height="15" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding DbStatusText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{Binding DbStatusColor}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════ STATUS BAR (compact, bottom) ═══════ -->
        <Border DockPanel.Dock="Bottom" Padding="12,6"
                Background="#0e1117" BorderBrush="#21262d" BorderThickness="0,1,0,0">
            <DockPanel>
                <!-- Left: status dot + text -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Ellipse Width="10" Height="10" Fill="{Binding GlobalStatusColor}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding GlobalStatusText}" FontSize="13" FontWeight="Medium"
                               Foreground="{Binding GlobalStatusColor}" VerticalAlignment="Center"/>
                </StackPanel>

                <Border/>
            </DockPanel>
        </Border>

        <!-- ═══════ MAIN CONTENT ═══════ -->
        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════ LEFT PANEL: Script List ═══════ -->
            <DockPanel Grid.Column="0" Background="#0e1117">
                <!-- Search bar -->
                <Border DockPanel.Dock="Top" Padding="10,8">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Search scripts..." FontSize="14"/>
                </Border>

                <!-- Status image strip (bottom of left panel) -->
                <Border DockPanel.Dock="Bottom" Padding="12,10"
                        Background="#161b22" BorderBrush="#21262d" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="{Binding GlobalStatusImageUri}" Width="64" Height="64"
                               Stretch="Uniform" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding GlobalStatusText}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{Binding GlobalStatusColor}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- New-root-folder button -->
                <Border DockPanel.Dock="Top" Padding="8,0,8,6">
                    <Button Content="+ Nueva carpeta" HorizontalContentAlignment="Left"
                            Style="{StaticResource DarkButton}" Padding="10,6"
                            Click="NewRootFolder_Click"/>
                </Border>

                <!-- Folder tree -->
                <TreeView x:Name="ScriptTree"
                          ItemsSource="{Binding FolderTree}"
                          Background="Transparent" BorderThickness="0"
                          Padding="4,2"
                          SelectedItemChanged="ScriptTree_SelectedItemChanged"
                          PreviewMouseLeftButtonDown="ScriptTree_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="ScriptTree_PreviewMouseMove"
                          AllowDrop="True" Drop="ScriptTree_Drop" DragOver="ScriptTree_DragOver"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="AllowDrop" Value="True"/>
                        </Style>
                    </TreeView.ItemContainerStyle>

                    <TreeView.Resources>
                        <!-- Folder node (has children) -->
                        <HierarchicalDataTemplate DataType="{x:Type h:FolderNodeViewModel}"
                                                  ItemsSource="{Binding Children}">
                            <Border x:Name="FolderRow" Padding="6,5" CornerRadius="5"
                                    Background="Transparent" Tag="{Binding}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                <Setter Property="Background" Value="#1f3a5f"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Nueva subcarpeta" Click="MenuNewSubfolder_Click"
                                                  Tag="{Binding}"/>
                                        <MenuItem Header="Renombrar" Click="MenuRenameFolder_Click"
                                                  Tag="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="Eliminar" Click="MenuDeleteFolder_Click"
                                                  Tag="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 2,5 L 6.2,5 L 7.6,6.8 L 14,6.8 L 14,13 L 2,13 Z"
                                          Fill="#58a6ff" Width="15" Height="15" Stretch="Uniform"
                                          Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#c9d1d9" VerticalAlignment="Center"/>
                                    <Border CornerRadius="6" Background="#111520" Padding="6,1" Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ScriptCount}" FontSize="10" Foreground="#7d8590"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </HierarchicalDataTemplate>

                        <!-- Script leaf -->
                        <DataTemplate DataType="{x:Type h:ScriptEntryViewModel}">
                            <Border Padding="2,1" Tag="{Binding}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="2" Background="{Binding StatusAccentBrush}"/>
                                    <Border Grid.Column="1" Padding="10,7" Background="Transparent">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" CornerRadius="6" Padding="7,3"
                                                    VerticalAlignment="Top" Background="{Binding StatusBadgeBg}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding StatusIcon}" Width="13" Height="13" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                               Foreground="{Binding StatusBadgeColor}"/>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium"
                                                           Foreground="#e6edf3"/>
                                                <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#484f58"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>

            <!-- ═══════ SPLITTER ═══════ -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- ═══════ RIGHT PANEL: Details + Log ═══════ -->
            <DockPanel Grid.Column="2" Background="#0e1117">

                <!-- Details panel (top) -->
                <Border DockPanel.Dock="Top" Padding="18,14" Background="#161b22"
                        BorderBrush="#21262d" BorderThickness="0,0,0,1">
                    <Grid DataContext="{Binding SelectedScript}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: script info -->
                        <StackPanel Grid.Column="0"
                                    Visibility="{Binding DataContext.SelectedScript, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold"
                                       Foreground="#e6edf3"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Subfolder: " FontSize="13" Foreground="#484f58"/>
                                <TextBlock Text="{Binding FolderName}" FontSize="13" Foreground="#58a6ff"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="Path: " FontSize="13" Foreground="#484f58"/>
                                <TextBlock Text="{Binding Path}" FontSize="13" Foreground="#7d8590"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="Interpreter: " FontSize="12" Foreground="#484f58"/>
                                <TextBlock Text="{Binding InterpreterDisplay}" FontSize="12" Foreground="#7d8590"/>
                                <TextBlock Text="   WorkDir: " FontSize="12" Foreground="#484f58"/>
                                <TextBlock Text="{Binding WorkDirDisplay}" FontSize="12" Foreground="#7d8590"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="Last Run: " FontSize="12" Foreground="#484f58"/>
                                <TextBlock Text="{Binding LastRun}" FontSize="12" Foreground="#7d8590"/>
                                <TextBlock Text="   Exit Code: " FontSize="12" Foreground="#484f58"/>
                                <TextBlock Text="{Binding ExitCodeDisplay}" FontSize="12" Foreground="#7d8590"/>
                                <TextBlock Text="   Auto-start: " FontSize="12" Foreground="#484f58"/>
                                <TextBlock Text="{Binding AutoStart}" FontSize="12" Foreground="#7d8590"/>
                            </StackPanel>
                            <Grid Margin="0,3,0,0"
                                  Visibility="{Binding ShowGitCommit, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Git: " FontSize="12" Foreground="#484f58"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding GitCommitText}"
                                           ToolTip="{Binding GitCommitText}"
                                           FontSize="12"
                                           Foreground="#58a6ff"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                        Visibility="{Binding HealthStatus, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Health: " FontSize="12" Foreground="#484f58"/>
                                <TextBlock Text="{Binding HealthStatus}" FontSize="12" Foreground="#3fb950"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Empty state -->
                        <TextBlock Grid.Column="0" Text="Select a script to view details"
                                   FontSize="14" Foreground="#484f58" VerticalAlignment="Center"
                                   Visibility="{Binding DataContext.SelectedScript, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}"/>

                        <!-- Right: status badge + deploy -->
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Top"
                                    Visibility="{Binding DataContext.SelectedScript, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                            <Border CornerRadius="8" Padding="12,6"
                                    Background="{Binding StatusBadgeBg}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding StatusIcon}" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="Medium"
                                               Foreground="{Binding StatusBadgeColor}"/>
                                </StackPanel>
                            </Border>

                            <Button Content="Deploy Git" Style="{StaticResource AccentButton}"
                                    Margin="0,10,0,0" Padding="12,6"
                                    Command="{Binding DataContext.DeployGitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    IsEnabled="{Binding CanTriggerGitDeploy}"
                                    Visibility="{Binding CanGitDeploy, Converter={StaticResource BoolToVisibility}}"/>

                            <TextBlock Text="Deploying..." Margin="4,6,0,0" FontSize="11" Foreground="#58a6ff"
                                       Visibility="{Binding IsDeploying, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Selected-script consumption -->
                <Border DockPanel.Dock="Top" Padding="12,10" Background="#10151f"
                        BorderBrush="#21262d" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="CONSUMO DEL SCRIPT (proceso + todos sus hijos)" FontSize="11" FontWeight="Bold"
                                   Foreground="#484f58" Margin="2,0,0,8"/>

                        <!-- Metric chips, only when the selected script is running -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasRunningProcessUsage, Converter={StaticResource BoolToVisibility}}">
                            <Border Background="#0d1117" BorderBrush="#21262d" BorderThickness="1"
                                    CornerRadius="8" Padding="14,8" Margin="0,0,10,0" MinWidth="120">
                                <StackPanel>
                                    <TextBlock Text="CPU" FontSize="10" FontWeight="Bold" Foreground="#484f58"/>
                                    <TextBlock Text="{Binding ProcUsageCpu}" FontSize="20" FontWeight="SemiBold"
                                               Foreground="#58a6ff" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#0d1117" BorderBrush="#21262d" BorderThickness="1"
                                    CornerRadius="8" Padding="14,8" Margin="0,0,10,0" MinWidth="120"
                                    ToolTip="Memoria privada sumada del proceso y todos sus hijos (node, etc.). El cmd raíz casi no consume; el peso está en los hijos.">
                                <StackPanel>
                                    <TextBlock Text="RAM" FontSize="10" FontWeight="Bold" Foreground="#484f58"/>
                                    <TextBlock Text="{Binding ProcUsageRam}" FontSize="20" FontWeight="SemiBold"
                                               Foreground="#3fb950" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#0d1117" BorderBrush="#21262d" BorderThickness="1"
                                    CornerRadius="8" Padding="14,8" Margin="0,0,10,0" MinWidth="100"
                                    ToolTip="PID del proceso raíz (el cmd que lanza el script). Sus hijos tienen otros PIDs.">
                                <StackPanel>
                                    <TextBlock Text="PID" FontSize="10" FontWeight="Bold" Foreground="#484f58"/>
                                    <TextBlock Text="{Binding ProcUsagePid}" FontSize="20" FontWeight="SemiBold"
                                               Foreground="#e6edf3" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#0d1117" BorderBrush="#21262d" BorderThickness="1"
                                    CornerRadius="8" Padding="14,8" MinWidth="140">
                                <StackPanel>
                                    <TextBlock Text="PROCESO" FontSize="10" FontWeight="Bold" Foreground="#484f58"/>
                                    <TextBlock Text="{Binding ProcUsageName}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="#7d8590" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Selecciona un script en ejecución para ver su consumo"
                                   FontSize="12" Foreground="#484f58" Margin="2,4,0,4"
                                   Visibility="{Binding HasRunningProcessUsage, Converter={StaticResource InverseBoolToVisibility}}"/>
                    </StackPanel>
                </Border>

                <!-- Log toolbar -->
                <Border DockPanel.Dock="Top" Padding="10,6" Background="#161b22"
                        BorderBrush="#21262d" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock Text="OUTPUT" FontSize="11" FontWeight="Bold" Foreground="#484f58"
                                   VerticalAlignment="Center" DockPanel.Dock="Left" Margin="6,0,0,0"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ToolIconButton}" ToolTip="Copy log"
                                    Command="{Binding CopyLogCommand}" Padding="8,5">
                                <TextBlock Text="Copy" FontSize="12" Foreground="#7d8590"/>
                            </Button>
                            <Button Style="{StaticResource ToolIconButton}" ToolTip="Save log to file"
                                    Command="{Binding SaveLogCommand}" Padding="8,5">
                                <TextBlock Text="Save" FontSize="12" Foreground="#7d8590"/>
                            </Button>
                            <Button Style="{StaticResource ToolIconButton}" ToolTip="Clear log"
                                    Command="{Binding ClearLogCommand}" Padding="8,5">
                                <TextBlock Text="Clear" FontSize="12" Foreground="#7d8590"/>
                            </Button>
                            <Rectangle Style="{StaticResource ToolbarSeparator}"/>
                            <Button Style="{StaticResource ToolIconButton}" ToolTip="Open logs folder"
                                    Command="{Binding OpenLogsFolderCommand}" Padding="8,5">
                                <Path Data="{StaticResource SaveGeometry}" Stroke="#7d8590" StrokeThickness="1.2"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                        <Border/>
                    </DockPanel>
                </Border>

                <!-- Log output -->
                <TextBox x:Name="LogOutput" IsReadOnly="True"
                         FontFamily="Cascadia Code, Consolas, monospace"
                         FontSize="13"
                         Text="{Binding LogContent, Mode=OneWay}"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         Background="#0d1117"
                         AcceptsReturn="True"
                         BorderThickness="0"
                         Padding="14,10"
                         ScrollViewer.ScrollChanged="LogOutput_ScrollChanged"
                         TextChanged="LogOutput_TextChanged"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
